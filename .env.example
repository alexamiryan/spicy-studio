# Copy to .env and adjust.

# Host folder mounted into the app at /exports. Users can pick "Server folder" as their
# save location in Settings; their files go into a subfolder of this.
# (Saving to a NAS over SMB is set per user in Settings -> Save location; nothing here.)
# Windows: C:/Users/you/Pictures/Studio   Linux/WSL: /home/you/Pictures/Studio   Relative: ./exports
EXPORT_ROOT=./exports

# Port the app is served on (open http://localhost:3000, or http://<this-pc-ip>:3000 from your phone).
PORT=3000

# Postgres password (internal to docker compose; change before first start).
POSTGRES_PASSWORD=change-me

# Where generated media and uploads are stored on the host.
DATA_PATH=./data

# Optional: key for encrypting stored secrets (API keys, Higgsfield login, SMB passwords).
# If empty, a random key is generated once into DATA_PATH/app.key. Back that file up with the
# database: without it the stored secrets can't be read (users would re-enter them).
APP_SECRET=

# Optional: create the first admin on start instead of in the browser (only used on an empty database).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: base URL agents (MCP) download results from, e.g. https://studio.tailnet.ts.net
# PUBLIC_URL=
